T = int(input())

for _ in range(T):
    V, N = map(int, input().split())
    coins = list(map(int, input().split()))

    dp = [999999] * (V + 1)
    used = [0] * (V + 1)

    dp[0] = 0

    for i in range(1, V + 1):
        for c in coins:
            if c <= i and dp[i-c] + 1 < dp[i]:
                dp[i] = dp[i-c] + 1
                used[i] = c

    if dp[V] == 999999:
        print(-1)
    else:
        ans = []
        x = V

        while x > 0:
            ans.append(used[x])
            x -= used[x]

        print(*ans)
        print(dp[V])
