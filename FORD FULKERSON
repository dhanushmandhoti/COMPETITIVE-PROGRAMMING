from collections import deque

V, E = map(int, input().split())
cap = [[0] * V for _ in range(V)]
g = [[] for _ in range(V)]

for _ in range(E):
    u, v, c = map(int, input().split())
    if cap[u][v] == 0:
        g[u].append(v)
        g[v].append(u)
    cap[u][v] += c

flow = 0
while True:
    p = [-1] * V
    p[0] = 0
    q = deque([0])
    while q and p[V - 1] < 0:
        u = q.popleft()
        for v in g[u]:
            if p[v] < 0 and cap[u][v]:
                p[v] = u
                q.append(v)

    if p[V - 1] < 0:
        break

    f, v = 10**18, V - 1
    while v:
        u = p[v]
        f = min(f, cap[u][v])
        v = u

    v = V - 1
    while v:
        u = p[v]
        cap[u][v] -= f
        cap[v][u] += f
        v = u
    flow += f

print(flow)
